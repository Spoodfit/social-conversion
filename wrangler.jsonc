{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neptune-social-conversion",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "placement": { "mode": "smart" },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  "vars": {
    "APP_ENV": "production",
    "DEMO_MODE": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neptune-social-conversion",
      "database_id": "6d245c85-f43b-49f6-9a9e-d6f9323ce946",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "neptune-social-conversion-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "neptune-social-events"
      }
    ],
    "consumers": [
      {
        "queue": "neptune-social-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "neptune-social-events-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
