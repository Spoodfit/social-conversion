{
  "name": "neptune-social-conversion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite --config vite.client.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "cf:check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "audit:recovery": "node scripts/recovery-audit.mjs",
    "validate:production-config": "node scripts/validate-production-config.mjs",
    "verify": "npm run cf-typegen && npm run typecheck && npm test && npm run audit:recovery && npm run build && npm run cf:check"
  },
  "dependencies": {
    "hono": "4.13.0",
    "jose": "6.2.8",
    "lucide-react": "1.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
